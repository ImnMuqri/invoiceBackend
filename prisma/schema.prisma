generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────
// Core User — Auth, Plan & Billing Identity
// ─────────────────────────────────────────────
model User {
  id                  Int     @id @default(autoincrement())
  email               String  @unique
  password            String
  plan                String  @default("FREE")
  role                Role    @default(USER)
  isActive            Boolean @default(true)
  onboardingCompleted Boolean @default(false)

  // Xendit billing linkage (lives here, not on Subscription, so webhook can find user fast)
  xenditCustomerId     String?
  xenditSubscriptionId String?

  // Referral system
  referralCode         String? @unique
  referralCredits      Int     @default(0)
  referralCreditEarned Boolean @default(false)
  referredById         Int?
  referredBy           User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals            User[]  @relation("UserReferrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-1 sub-models
  profile       UserProfile?
  quota         UserQuota?
  notification  UserNotification?
  invoiceConfig UserInvoiceConfig?
  manualPayment ManualPayment?

  // 1-to-many
  clients            Client[]
  invoices           Invoice[]
  paymentProviders   PaymentProvider[]
  subscriptions      Subscription[]
  notifications      AppNotification[]
  tickets            Ticket[]
  catalogue          CatalogueItem[]
  usagePeriods       UsagePeriod[]
  topUps             TopUp[]
  messageLogs        MessageLog[]
  recurringSchedules RecurringSchedule[]
  creditNotes        CreditNote[]
}

// ─────────────────────────────────────────────
// UserProfile — Personal & Company Info
// ─────────────────────────────────────────────
model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  phoneNumber     String?
  heardAbout      String?
  currentStatus   String?
  companyName     String?
  companyEmail    String?
  companyPhone    String?
  address         String?
  logoUrl         String?
  defaultCurrency String   @default("MYR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Tax and business identifiers (spec 05).
  ///
  /// Stored now because they are painful to collect retroactively: adding them
  /// later means emailing every existing user asking them to go and fill
  /// something in, which most will not do. All optional — nothing here blocks
  /// creating an invoice, and an account that fills none of them looks exactly
  /// as it does today.
  registrationNumber String?
  tin                String?
  msicCode           String?
  sstNumber          String?

  /// The one-time prompt (spec 05). Set once, never unset: "collect quietly, do
  /// not interrupt" means a dismissal is permanent, not a snooze. Kept here
  /// rather than in local storage so dismissing on a laptop also dismisses on a
  /// phone — the same person already said no.
  taxPromptDismissed Boolean @default(false)
}

// ─────────────────────────────────────────────
// UserQuota — Monthly Usage Counters
// Reset on billing cycle, compared against Plan limits
// ─────────────────────────────────────────────
/// A user's one-time trial chases live here rather than in UsagePeriod, because
/// UsagePeriod is per-period and this grant deliberately never renews.
model UserQuota {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waSendsUsed        Int      @default(0)
  emailSendsUsed     Int      @default(0)
  waRemindersUsed    Int      @default(0)
  emailRemindersUsed Int      @default(0)
  aiUsed             Int      @default(0)
  invoicesUsed       Int      @default(0)
  /// Counted separately from invoices: quoting for work you do not win should
  /// not spend the allowance for billing the work you do.
  quotesUsed         Int      @default(0)
  lastResetDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Spent trial chases. Never reset by the monthly job.
  trialChasesUsed Int @default(0)
}

// ─────────────────────────────────────────────
// UserNotification — Automation & Integration Settings
// WhatsApp, Email, Twilio, Auto-Chaser, AI Cache
// ─────────────────────────────────────────────
model UserNotification {
  id                       Int       @id @default(autoincrement())
  userId                   Int       @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderInterval         Int       @default(0)
  whatsappReminderInterval Int       @default(0)
  whatsappMode             String    @default("SYSTEM")
  whatsappSendTemplate     String?   @default("{{userName}} {{companyName}} via InvoKita\n\nHello {{clientName}}, here is your invoice {{invoiceNumber}} for {{totalAmount}} {{currency}}. Due on {{dueDate}}. View here: {{invoiceUrl}}")
  whatsappReminderTemplate String?   @default("{{userName}} {{companyName}} via InvoKita\n\nFriendly reminder for {{clientName}}: Your invoice {{invoiceNumber}} ({{totalAmount}} {{currency}}) is due on {{dueDate}}. Please ignore if already paid.")
  twilioSid                String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  globalAutoChaser         Boolean   @default(true)
  // AI Insights cache — stored here to avoid bloating the User row
  aiInsights               String?
  lastAiInsightAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// UserInvoiceConfig — Invoice Branding & Defaults
// ─────────────────────────────────────────────
model UserInvoiceConfig {
  id                              Int      @id @default(autoincrement())
  userId                          Int      @unique
  user                            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoicePrefix                   String   @default("INV")
  /// Quotes get their own prefix and their own sequence, so issuing a quote
  /// never advances the invoice numbering. An accountant reading a run of
  /// invoice numbers with gaps in it will ask why.
  quotePrefix                     String   @default("QUO")
  /// Credit notes carry their own sequence; an accountant expects them
  /// numbered separately from invoices.
  creditNotePrefix                String   @default("CN")
  defaultTaxRate                  Float    @default(0.0)
  invoiceIncludeName              Boolean  @default(true)
  invoiceIncludeEmail             Boolean  @default(false)
  invoiceIncludePersonalPhone     Boolean  @default(false)
  invoiceIncludeCompanyPhone      Boolean  @default(true)
  invoiceIncludeCompanyName       Boolean  @default(true)
  invoiceIncludeAddress           Boolean  @default(true)
  /// One switch per block rather than one per field (spec 05). The fields only
  /// ever render when they are actually filled in, so these exist for the user
  /// who has entered their identifiers and does not want them on the document —
  /// not as a way to build the block up field by field.
  invoiceIncludeTaxIdentifiers    Boolean  @default(true)
  invoiceIncludeClientIdentifiers Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  /// Where the monthly export goes (spec 04). Null means the job is off — the
  /// address IS the switch, so there is no way to have it on and going nowhere.
  accountantEmail String?
}

// ─────────────────────────────────────────────
// ManualPayment — Bank Transfer / QR Payment Details
// ─────────────────────────────────────────────
model ManualPayment {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String?
  accountNumber String?
  accountName   String?
  qrCode        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PaymentProvider — Connected Gateways (ToyyibPay, Billplz)
// ─────────────────────────────────────────────
model PaymentProvider {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String // "TOYYIBPAY" or "BILLPLZ"
  apiKey        String? // Encrypted
  secretKey     String? // Encrypted
  collectionId  String?
  categoryCode  String?
  xSignatureKey String? // Encrypted
  merchantId    String?
  salt          String? // Encrypted
  isPreferred   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, provider, isActive])
}

// ─────────────────────────────────────────────
// Client — Belongs to a User
// ─────────────────────────────────────────────
model Client {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String
  phone              String?
  address            String?
  company            String
  averageDelayDays   Int                 @default(0)
  totalRevenue       Int                 @default(0)
  profitMargin       Float               @default(0)
  status             String              @default("Active")
  autoChaser         Boolean             @default(false)
  autoEmailChaser    Boolean             @default(false)
  invoices           Invoice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recurringSchedules RecurringSchedule[]

  /// Client-side identifiers (spec 05). Optional, like the business ones.
  registrationNumber String?
  tin                String?
  /// An individual rather than a business, which changes which identifiers are
  /// relevant to ask for at all.
  isIndividual       Boolean @default(false)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Invoice — Core billing entity
// Intentionally snapshots sender info at creation time
// ─────────────────────────────────────────────
// One table, two kinds of document.
//
// A quotation and an invoice share everything that matters — the client, the
// line items, the sender's letterhead, the PDF — and differ in three things:
// what it is called, whether it can be paid, and which date matters. A separate
// Quotation model would have duplicated twenty fields and the whole builder and
// PDF stack to express those three differences.
//
// The cost of the discriminator is discipline, and it is a real cost. Every
// query that assumes money is owed MUST filter on kind, or the chaser emails a
// client that their quotation is overdue. The guarded call sites are:
//
//   src/plugins/cron.js      overdue marking, email + WhatsApp reminders
//   src/routes/pay/*         a quote has nothing to pay
//   src/routes/invoices/*    the money-shaped endpoints
//   src/routes/dashboard/*   outstanding totals
//
// Existing rows all become INVOICE, so the migration is a no-op behaviourally.
model Invoice {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  /// "INVOICE" | "QUOTE"
  kind String @default("INVOICE")

  /// Per-user sequence. Quotes count on their own so invoice numbers never gap.
  userInvoiceNumber Int     @default(0)
  userQuoteNumber   Int?
  invoiceNumber     String?
  invoiceName       String?
  subject           String?
  fromName          String?
  fromCompanyName   String?
  fromEmail         String?
  fromPhone         String?
  fromAddress       String?

  /// Tax identifiers, FROZEN at issue (spec 05).
  ///
  /// Copied from UserProfile when the document is created rather than read
  /// live, for the same reason fromName and fromAddress above it are copied:
  /// the client is holding this document, and correcting a typo in your TIN
  /// today must not silently rewrite an invoice you issued last year. The copy
  /// on file and the copy on screen have to keep matching.
  fromRegistrationNumber String?
  fromTin                String?
  fromMsicCode           String?
  fromSstNumber          String?
  date                   DateTime @default(now())

  /// Invoices only. Nullable because a quotation is not owed on a date — it
  /// expires on one, which is validUntil below.
  dueDate    DateTime?
  /// Quotes only. After this the quote is stale and should not be accepted.
  validUntil DateTime?

  /// Conversion is non-destructive: accepting a quote creates a NEW invoice and
  /// leaves the quote standing, so the accepted document survives as a record
  /// and both ends can be shown to the client.
  /// Reduced by credit notes. Sum of CreditNote.amount for this invoice.
  amountAdjusted Int @default(0)
  /// amount - amountPaid - amountAdjusted, in sen.
  ///
  /// Stored rather than computed on read because it is QUERIED, not just shown:
  /// the chaser filters on it, the dashboard groups by it, and the lists count
  /// by it. It is written only by recalculate() in utils/invoiceMoney.js, which
  /// is the single writer for every money field on this row — nothing else may
  /// set these four, which is what stops them drifting apart.
  amountDue      Int @default(0)

  /// Voiding cancels an invoice that should never have been issued. The number
  /// is kept: gaps in a sequence are normal, reuse is not.
  voidedAt   DateTime?
  voidReason String?

  payments    Payment[]
  creditNotes CreditNote[]

  /// Set when this invoice was generated by a recurring schedule.
  scheduleId     Int?
  schedule       RecurringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// The schedule period this instance covers. Unique per schedule, which is
  /// what makes generation idempotent: a job that runs twice cannot produce two
  /// invoices for the same period, whatever the retry looks like.
  schedulePeriod String?

  /// The period ("YYYY-MM") in which this invoice was first counted as chased.
  /// Null until its first WhatsApp message. Rolling into a new period and being
  /// chased again counts again, which is why this stores the period rather than
  /// a boolean.
  chasedInPeriod String?
  /// Total WhatsApp messages sent for this invoice, against Plan.waPerInvoiceCap.
  waMessageCount Int     @default(0)

  messageLogs MessageLog[]

  convertedFromId Int?     @unique
  convertedFrom   Invoice? @relation("QuoteToInvoice", fields: [convertedFromId], references: [id])
  convertedTo     Invoice? @relation("QuoteToInvoice")

  amount                   Int
  amountPaid               Int           @default(0)
  status                   String        @default("Pending")
  currency                 String        @default("MYR")
  latePrediction           String?
  predictedDelayDays       Int?
  whatsappStatus           String        @default("Not Sent")
  whatsappLastSent         DateTime?
  emailLastSent            DateTime?
  whatsappLastReminderSent DateTime?
  emailLastReminderSent    DateTime?
  paidAt                   DateTime?
  template                 String        @default("professional")
  items                    InvoiceItem[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@unique([scheduleId, schedulePeriod])
  @@index([userId, kind, status])
  @@index([userId, kind, date(sort: Desc)])
  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  price     Int
  total     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// CatalogueItem — the things you sell, priced once
// ─────────────────────────────────────────────
// Deliberately NOT an inventory model. There is no stock level, no reorder
// point and no movement history, because nothing in this product decrements a
// quantity when an invoice goes out — promising that in the schema would be a
// lie the UI then has to keep. This is a price list: the name, what it costs and
// what a unit of it is, so a line item can be filled in from one click instead
// of retyped for the hundredth time.
//
// A line item copies these values rather than pointing at them. An invoice sent
// two years ago must still say what it said, so raising your day rate cannot be
// allowed to rewrite history. That is why there is no relation from InvoiceItem
// back to here — see InvoiceItem, which stays a plain row of text and numbers.
model CatalogueItem {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Int     @default(0)
  // "hour", "day", "each", "project" — free text, because the unit a plumber
  // uses and the unit a designer uses have nothing in common.
  unit        String?

  // Archived rather than deleted: an item you no longer sell still appears on
  // invoices you have already sent, and removing it should not imply otherwise.
  archived Boolean @default(false)

  timesUsed  Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archived])
}

// ─────────────────────────────────────────────
// UsagePeriod — metered usage, one row per account per billing period
// ─────────────────────────────────────────────
/// Keyed on the period rather than counted into a single mutable row, so usage
/// history survives and a period boundary cannot silently erase what happened.
/// The period key is YYYY-MM in Asia/Kuala_Lumpur — the user's own month, not
/// the server's.
model UsagePeriod {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM", Asia/Kuala_Lumpur.
  periodKey String

  /// Distinct invoices chased over WhatsApp this period.
  chasedInvoices Int @default(0)
  waMessages     Int @default(0)
  emailMessages  Int @default(0)

  /// WhatsApp sends that fell back to email because the allowance was spent.
  downgrades        Int     @default(0)
  /// One notification per period about downgrades, not one per message.
  downgradeNotified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey])
  @@index([userId])
}

// ─────────────────────────────────────────────
// TopUp — extra chased invoices bought mid-period
// ─────────────────────────────────────────────
/// Consumed only after the plan allowance is exhausted, and deliberately does
/// not roll over: the balance is scoped to the period it was bought for.
model TopUp {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Chased invoices this top-up grants, and how many have been used.
  chasedInvoices Int
  consumed       Int @default(0)

  /// The period this balance belongs to. Unused balance expires with it.
  periodKey String

  price    Int
  currency String @default("MYR")

  /// PENDING until the payment is confirmed; only ACTIVE balance is spendable.
  status     String  @default("PENDING")
  paymentRef String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, periodKey, status])
}

// ─────────────────────────────────────────────
// MessageLog — what was actually sent, on what channel, in what category
// ─────────────────────────────────────────────
/// Exists so per-message cost can be audited after the fact. WhatsApp template
/// category materially changes unit cost in Malaysia — utility is far cheaper
/// than marketing — and without recording the category actually used there is
/// no way to check the bill against what was sent.
model MessageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// "WHATSAPP" | "EMAIL"
  channel  String
  /// "SEND" | "REMINDER"
  purpose  String
  /// "UTILITY" | "MARKETING" | "NA" (email)
  category String @default("NA")

  /// True when this went by email because WhatsApp allowance was exhausted.
  downgraded      Boolean @default(false)
  downgradeReason String?

  providerRef String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// RecurringSchedule — a template plus a cadence
// ─────────────────────────────────────────────
/// A schedule is NOT an invoice and never has a paid status. It generates
/// instances, which are ordinary invoices in every respect once created —
/// chased, paid and adjusted like any other.
///
/// The document content lives here rather than being read from account defaults
/// at generation time. A retainer agreed at one rate must keep issuing at that
/// rate when the user later changes their default tax rate or currency; the
/// schedule is the agreement, and only editing it should change what it issues.
model RecurringSchedule {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoiceName String?
  subject     String?
  currency    String          @default("MYR")
  taxRate     Float           @default(0)
  items       RecurringItem[]

  /// "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY", every `interval` of those.
  frequency String @default("MONTHLY")
  interval  Int    @default(1)
  /// Day of month for monthly and longer; day of week (0=Sunday) for weekly.
  /// 29, 30 and 31 fall back to the last day of a shorter month — never skip.
  issueDay  Int?

  startDate DateTime
  /// "NEVER" | "AFTER_N" | "ON_DATE"
  endMode   String    @default("NEVER")
  endAfter  Int?
  endDate   DateTime?

  /// Days added to the issue date to derive each instance's due date.
  paymentTermsDays Int @default(14)

  /// Delivery channels for instances: any of "EMAIL", "WHATSAPP".
  channels         String[] @default(["EMAIL"])
  autoChase        Boolean  @default(true)
  reminderInterval Int?

  /// "REVIEW" (create as draft, needs approval) | "AUTO" (create and deliver).
  mode             String  @default("REVIEW")
  /// New schedules are held in review for two occurrences, then the user is
  /// asked whether to switch. Users are nervous about software invoicing their
  /// clients unattended; earning that in two cycles is cheaper than losing them
  /// in one. A draft is never auto-sent even after this reaches zero — only the
  /// offer to change mode is triggered.
  reviewRemaining  Int     @default(2)
  reviewPromptSent Boolean @default(false)

  /// Do not issue while the previous instance is still unpaid. Off by default,
  /// but offered: some users do not want to stack retainers on a client who has
  /// stopped paying.
  skipWhileUnpaid Boolean @default(false)

  /// "ACTIVE" | "PAUSED" | "ENDED" | "CANCELLED"
  status       String  @default("ACTIVE")
  /// Why a schedule paused itself, e.g. the client was archived.
  statusReason String?

  occurrences   Int       @default(0)
  lastPeriodKey String?
  nextIssueAt   DateTime?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, nextIssueAt])
  @@index([clientId])
}

/// Line items belong to the schedule, copied onto each instance at generation.
/// Copied rather than referenced for the same reason invoice items are: an
/// issued invoice must keep saying what it said.
model RecurringItem {
  id         Int               @id @default(autoincrement())
  scheduleId Int
  schedule   RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  quantity   Int               @default(1)

  @@index([scheduleId])
}

// ─────────────────────────────────────────────
// Payment — money actually received against an invoice
// ─────────────────────────────────────────────
/// Replaces the binary paid flag. A gateway confirming less than the full
/// amount now produces a partial payment rather than a settled invoice, which
/// is the whole point of spec 03: the chaser was pursuing clients who had
/// already paid something, and that is the failure most likely to make somebody
/// switch the chaser off and then leave.
model Payment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Sen. Positive. Overpayment is allowed and shows as a negative amountDue.
  amount     Int
  receivedAt DateTime @default(now())

  /// Gateway name, or "BANK_TRANSFER" | "CASH" | "CHEQUE" | "OTHER".
  method    String  @default("OTHER")
  reference String?
  note      String?

  /// True when a gateway webhook created this, false when a user entered it.
  automatic  Boolean @default(false)
  /// The gateway's own id for the transaction. Unique so a webhook delivered
  /// twice cannot record the same money twice.
  gatewayRef String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// CreditNote — reduces what is owed, no money moves
// ─────────────────────────────────────────────
/// For post-issue discounts, goodwill, cancelled lines and corrections. It has
/// its own sequence because it is its own document: an accountant expects to
/// see credit notes numbered separately from invoices.
model CreditNote {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Own sequence, per user.
  userNumber Int
  number     String

  /// Sen. Cannot exceed the invoice's amountDue at the time of issue.
  amount   Int
  reason   String
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Subscription — Billing history per user
// ─────────────────────────────────────────────
/// `allowances` freezes the plan's limits as they were when the subscription
/// started, so grandfathered pricing survives later edits to the Plan row. Read
/// it in preference to the live Plan for anyone who has one.
model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xenditSubscriptionId String?   @unique
  plan                 String
  amount               Int
  currency             String    @default("MYR")
  status               String    @default("PENDING")
  subscriptionStart    DateTime?
  subscriptionEnds     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Snapshot of the Plan's limits at the moment of subscribing.
  allowances Json?

  @@index([userId])
}

// ─────────────────────────────────────────────
// PromoCode — Discount codes for subscriptions
// ─────────────────────────────────────────────
model PromoCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String // "PERCENTAGE" or "FIXED"
  discountValue Float
  maxUses       Int?
  uses          Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// Plan — Pricing tiers (admin-managed in DB)
// ─────────────────────────────────────────────
model Plan {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  description    String?
  price          Int     @default(0)
  currency       String  @default("MYR")
  interval       String  @default("month")
  waSends        Int     @default(0)
  emailSends     Int     @default(0)
  aiCredits      Int     @default(0)
  waReminders    Int     @default(0)
  emailReminders Int     @default(0)
  invoices       Int     @default(0)
  /// Monthly quotations. Seeded per plan; see prisma/seed-plans.js.
  quotes         Int     @default(0)

  /// THE metered unit. One "chased invoice" covers the first WhatsApp message
  /// sent for an invoice plus its follow-up reminders within the same billing
  /// period. Invoice creation costs nothing to serve; WhatsApp messages do, so
  /// this is the number that actually runs out — and the one the pricing page
  /// should lead with.
  chasedInvoices Int @default(0)

  /// One-time, non-renewing grant for new accounts, so a free user can see a
  /// full chase cycle complete before deciding. Free only; zero elsewhere.
  trialChases Int @default(0)

  /// Hard ceiling on WhatsApp messages for a single invoice. Not a selling
  /// point — an abuse guard, so one pathological invoice cannot drain the
  /// account's allowance through repeated manual sends.
  waPerInvoiceCap Int      @default(6)
  features        String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SystemConfiguration — Global admin kill-switches
// ─────────────────────────────────────────────
model SystemConfiguration {
  id                     Int      @id @default(autoincrement())
  whatsappEnabled        Boolean  @default(true)
  emailEnabled           Boolean  @default(true)
  invoiceCreationEnabled Boolean  @default(true)
  paymentsEnabled        Boolean  @default(true)
  globalNotice           String?
  maintenanceMode        Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AppNotification — In-app user notifications
// ─────────────────────────────────────────────
model AppNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // 'EMAIL_SENT', 'WHATSAPP_SENT', 'CLIENT_PAID', 'PARTIALLY_PAID', 'OVERDUE'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// Support Ticket System
// ─────────────────────────────────────────────
model Ticket {
  id        Int      @id @default(autoincrement())
  resendId  String?  @unique // Id from Resend Inbound (for replies/threading)
  subject   String
  fromEmail String
  fromName  String?
  status    String   @default("OPEN") // OPEN, PENDING, CLOSED
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conversation history
  messages TicketMessage[]

  // Link to user if email matches
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String // "ADMIN" or "USER"
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}
