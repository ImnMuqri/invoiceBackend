generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────
// Core User — Auth, Plan & Billing Identity
// ─────────────────────────────────────────────
model User {
  id                  Int     @id @default(autoincrement())
  email               String  @unique
  password            String
  plan                String  @default("FREE")
  role                Role    @default(USER)
  isActive            Boolean @default(true)
  onboardingCompleted Boolean @default(false)

  // Xendit billing linkage (lives here, not on Subscription, so webhook can find user fast)
  xenditCustomerId     String?
  xenditSubscriptionId String?

  // Referral system
  referralCode         String? @unique
  referralCredits      Int     @default(0)
  referralCreditEarned Boolean @default(false)
  referredById         Int?
  referredBy           User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals            User[]  @relation("UserReferrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-1 sub-models
  profile       UserProfile?
  quota         UserQuota?
  notification  UserNotification?
  invoiceConfig UserInvoiceConfig?
  manualPayment ManualPayment?

  // 1-to-many
  clients          Client[]
  invoices         Invoice[]
  paymentProviders PaymentProvider[]
  subscriptions    Subscription[]
  notifications    AppNotification[]
  tickets          Ticket[]
  catalogue        CatalogueItem[]
  usagePeriods     UsagePeriod[]
  topUps           TopUp[]
  messageLogs      MessageLog[]
}

// ─────────────────────────────────────────────
// UserProfile — Personal & Company Info
// ─────────────────────────────────────────────
model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  phoneNumber     String?
  heardAbout      String?
  currentStatus   String?
  companyName     String?
  companyEmail    String?
  companyPhone    String?
  address         String?
  logoUrl         String?
  defaultCurrency String   @default("MYR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// UserQuota — Monthly Usage Counters
// Reset on billing cycle, compared against Plan limits
// ─────────────────────────────────────────────
/// A user's one-time trial chases live here rather than in UsagePeriod, because
/// UsagePeriod is per-period and this grant deliberately never renews.
model UserQuota {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waSendsUsed        Int      @default(0)
  emailSendsUsed     Int      @default(0)
  waRemindersUsed    Int      @default(0)
  emailRemindersUsed Int      @default(0)
  aiUsed             Int      @default(0)
  invoicesUsed       Int      @default(0)
  /// Counted separately from invoices: quoting for work you do not win should
  /// not spend the allowance for billing the work you do.
  quotesUsed         Int      @default(0)
  lastResetDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Spent trial chases. Never reset by the monthly job.
  trialChasesUsed Int @default(0)
}

// ─────────────────────────────────────────────
// UserNotification — Automation & Integration Settings
// WhatsApp, Email, Twilio, Auto-Chaser, AI Cache
// ─────────────────────────────────────────────
model UserNotification {
  id                       Int       @id @default(autoincrement())
  userId                   Int       @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderInterval         Int       @default(0)
  whatsappReminderInterval Int       @default(0)
  whatsappMode             String    @default("SYSTEM")
  whatsappSendTemplate     String?   @default("{{userName}} {{companyName}} via InvoKita\n\nHello {{clientName}}, here is your invoice {{invoiceNumber}} for {{totalAmount}} {{currency}}. Due on {{dueDate}}. View here: {{invoiceUrl}}")
  whatsappReminderTemplate String?   @default("{{userName}} {{companyName}} via InvoKita\n\nFriendly reminder for {{clientName}}: Your invoice {{invoiceNumber}} ({{totalAmount}} {{currency}}) is due on {{dueDate}}. Please ignore if already paid.")
  twilioSid                String?
  twilioAuthToken          String?
  twilioPhoneNumber        String?
  globalAutoChaser         Boolean   @default(true)
  // AI Insights cache — stored here to avoid bloating the User row
  aiInsights               String?
  lastAiInsightAt          DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// UserInvoiceConfig — Invoice Branding & Defaults
// ─────────────────────────────────────────────
model UserInvoiceConfig {
  id                          Int      @id @default(autoincrement())
  userId                      Int      @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoicePrefix               String   @default("INV")
  /// Quotes get their own prefix and their own sequence, so issuing a quote
  /// never advances the invoice numbering. An accountant reading a run of
  /// invoice numbers with gaps in it will ask why.
  quotePrefix                 String   @default("QUO")
  defaultTaxRate              Float    @default(0.0)
  invoiceIncludeName          Boolean  @default(true)
  invoiceIncludeEmail         Boolean  @default(false)
  invoiceIncludePersonalPhone Boolean  @default(false)
  invoiceIncludeCompanyPhone  Boolean  @default(true)
  invoiceIncludeCompanyName   Boolean  @default(true)
  invoiceIncludeAddress       Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ManualPayment — Bank Transfer / QR Payment Details
// ─────────────────────────────────────────────
model ManualPayment {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String?
  accountNumber String?
  accountName   String?
  qrCode        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PaymentProvider — Connected Gateways (ToyyibPay, Billplz)
// ─────────────────────────────────────────────
model PaymentProvider {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String // "TOYYIBPAY" or "BILLPLZ"
  apiKey        String? // Encrypted
  secretKey     String? // Encrypted
  collectionId  String?
  categoryCode  String?
  xSignatureKey String? // Encrypted
  merchantId    String?
  salt          String? // Encrypted
  isPreferred   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, provider, isActive])
}

// ─────────────────────────────────────────────
// Client — Belongs to a User
// ─────────────────────────────────────────────
model Client {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  address          String?
  company          String
  averageDelayDays Int       @default(0)
  totalRevenue     Float     @default(0.0)
  profitMargin     Float     @default(0.0)
  status           String    @default("Active")
  autoChaser       Boolean   @default(false)
  autoEmailChaser  Boolean   @default(false)
  invoices         Invoice[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// Invoice — Core billing entity
// Intentionally snapshots sender info at creation time
// ─────────────────────────────────────────────
// One table, two kinds of document.
//
// A quotation and an invoice share everything that matters — the client, the
// line items, the sender's letterhead, the PDF — and differ in three things:
// what it is called, whether it can be paid, and which date matters. A separate
// Quotation model would have duplicated twenty fields and the whole builder and
// PDF stack to express those three differences.
//
// The cost of the discriminator is discipline, and it is a real cost. Every
// query that assumes money is owed MUST filter on kind, or the chaser emails a
// client that their quotation is overdue. The guarded call sites are:
//
//   src/plugins/cron.js      overdue marking, email + WhatsApp reminders
//   src/routes/pay/*         a quote has nothing to pay
//   src/routes/invoices/*    the money-shaped endpoints
//   src/routes/dashboard/*   outstanding totals
//
// Existing rows all become INVOICE, so the migration is a no-op behaviourally.
model Invoice {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  /// "INVOICE" | "QUOTE"
  kind String @default("INVOICE")

  /// Per-user sequence. Quotes count on their own so invoice numbers never gap.
  userInvoiceNumber Int      @default(0)
  userQuoteNumber   Int?
  invoiceNumber     String?
  invoiceName       String?
  subject           String?
  fromName          String?
  fromCompanyName   String?
  fromEmail         String?
  fromPhone         String?
  fromAddress       String?
  date              DateTime @default(now())

  /// Invoices only. Nullable because a quotation is not owed on a date — it
  /// expires on one, which is validUntil below.
  dueDate    DateTime?
  /// Quotes only. After this the quote is stale and should not be accepted.
  validUntil DateTime?

  /// Conversion is non-destructive: accepting a quote creates a NEW invoice and
  /// leaves the quote standing, so the accepted document survives as a record
  /// and both ends can be shown to the client.
  /// The period ("YYYY-MM") in which this invoice was first counted as chased.
  /// Null until its first WhatsApp message. Rolling into a new period and being
  /// chased again counts again, which is why this stores the period rather than
  /// a boolean.
  chasedInPeriod String?
  /// Total WhatsApp messages sent for this invoice, against Plan.waPerInvoiceCap.
  waMessageCount Int     @default(0)

  messageLogs MessageLog[]

  convertedFromId Int?     @unique
  convertedFrom   Invoice? @relation("QuoteToInvoice", fields: [convertedFromId], references: [id])
  convertedTo     Invoice? @relation("QuoteToInvoice")

  amount                   Float
  amountPaid               Float         @default(0.0)
  status                   String        @default("Pending")
  currency                 String        @default("MYR")
  latePrediction           String?
  predictedDelayDays       Int?
  whatsappStatus           String        @default("Not Sent")
  whatsappLastSent         DateTime?
  emailLastSent            DateTime?
  whatsappLastReminderSent DateTime?
  emailLastReminderSent    DateTime?
  paidAt                   DateTime?
  template                 String        @default("professional")
  items                    InvoiceItem[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([userId, kind, status])
  @@index([userId, kind, date(sort: Desc)])
  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  price     Float
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// CatalogueItem — the things you sell, priced once
// ─────────────────────────────────────────────
// Deliberately NOT an inventory model. There is no stock level, no reorder
// point and no movement history, because nothing in this product decrements a
// quantity when an invoice goes out — promising that in the schema would be a
// lie the UI then has to keep. This is a price list: the name, what it costs and
// what a unit of it is, so a line item can be filled in from one click instead
// of retyped for the hundredth time.
//
// A line item copies these values rather than pointing at them. An invoice sent
// two years ago must still say what it said, so raising your day rate cannot be
// allowed to rewrite history. That is why there is no relation from InvoiceItem
// back to here — see InvoiceItem, which stays a plain row of text and numbers.
model CatalogueItem {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float   @default(0)
  // "hour", "day", "each", "project" — free text, because the unit a plumber
  // uses and the unit a designer uses have nothing in common.
  unit        String?

  // Archived rather than deleted: an item you no longer sell still appears on
  // invoices you have already sent, and removing it should not imply otherwise.
  archived Boolean @default(false)

  timesUsed  Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archived])
}

// ─────────────────────────────────────────────
// UsagePeriod — metered usage, one row per account per billing period
// ─────────────────────────────────────────────
/// Keyed on the period rather than counted into a single mutable row, so usage
/// history survives and a period boundary cannot silently erase what happened.
/// The period key is YYYY-MM in Asia/Kuala_Lumpur — the user's own month, not
/// the server's.
model UsagePeriod {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM", Asia/Kuala_Lumpur.
  periodKey String

  /// Distinct invoices chased over WhatsApp this period.
  chasedInvoices Int @default(0)
  waMessages     Int @default(0)
  emailMessages  Int @default(0)

  /// WhatsApp sends that fell back to email because the allowance was spent.
  downgrades        Int     @default(0)
  /// One notification per period about downgrades, not one per message.
  downgradeNotified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey])
  @@index([userId])
}

// ─────────────────────────────────────────────
// TopUp — extra chased invoices bought mid-period
// ─────────────────────────────────────────────
/// Consumed only after the plan allowance is exhausted, and deliberately does
/// not roll over: the balance is scoped to the period it was bought for.
model TopUp {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Chased invoices this top-up grants, and how many have been used.
  chasedInvoices Int
  consumed       Int @default(0)

  /// The period this balance belongs to. Unused balance expires with it.
  periodKey String

  price    Float
  currency String @default("MYR")

  /// PENDING until the payment is confirmed; only ACTIVE balance is spendable.
  status     String  @default("PENDING")
  paymentRef String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, periodKey, status])
}

// ─────────────────────────────────────────────
// MessageLog — what was actually sent, on what channel, in what category
// ─────────────────────────────────────────────
/// Exists so per-message cost can be audited after the fact. WhatsApp template
/// category materially changes unit cost in Malaysia — utility is far cheaper
/// than marketing — and without recording the category actually used there is
/// no way to check the bill against what was sent.
model MessageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// "WHATSAPP" | "EMAIL"
  channel  String
  /// "SEND" | "REMINDER"
  purpose  String
  /// "UTILITY" | "MARKETING" | "NA" (email)
  category String @default("NA")

  /// True when this went by email because WhatsApp allowance was exhausted.
  downgraded      Boolean @default(false)
  downgradeReason String?

  providerRef String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// Subscription — Billing history per user
// ─────────────────────────────────────────────
/// `allowances` freezes the plan's limits as they were when the subscription
/// started, so grandfathered pricing survives later edits to the Plan row. Read
/// it in preference to the live Plan for anyone who has one.
model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xenditSubscriptionId String?   @unique
  plan                 String
  amount               Float
  currency             String    @default("MYR")
  status               String    @default("PENDING")
  subscriptionStart    DateTime?
  subscriptionEnds     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Snapshot of the Plan's limits at the moment of subscribing.
  allowances Json?

  @@index([userId])
}

// ─────────────────────────────────────────────
// PromoCode — Discount codes for subscriptions
// ─────────────────────────────────────────────
model PromoCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String // "PERCENTAGE" or "FIXED"
  discountValue Float
  maxUses       Int?
  uses          Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// Plan — Pricing tiers (admin-managed in DB)
// ─────────────────────────────────────────────
model Plan {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  description    String?
  price          Float   @default(0.0)
  currency       String  @default("MYR")
  interval       String  @default("month")
  waSends        Int     @default(0)
  emailSends     Int     @default(0)
  aiCredits      Int     @default(0)
  waReminders    Int     @default(0)
  emailReminders Int     @default(0)
  invoices       Int     @default(0)
  /// Monthly quotations. Seeded per plan; see prisma/seed-plans.js.
  quotes         Int     @default(0)

  /// THE metered unit. One "chased invoice" covers the first WhatsApp message
  /// sent for an invoice plus its follow-up reminders within the same billing
  /// period. Invoice creation costs nothing to serve; WhatsApp messages do, so
  /// this is the number that actually runs out — and the one the pricing page
  /// should lead with.
  chasedInvoices Int @default(0)

  /// One-time, non-renewing grant for new accounts, so a free user can see a
  /// full chase cycle complete before deciding. Free only; zero elsewhere.
  trialChases Int @default(0)

  /// Hard ceiling on WhatsApp messages for a single invoice. Not a selling
  /// point — an abuse guard, so one pathological invoice cannot drain the
  /// account's allowance through repeated manual sends.
  waPerInvoiceCap Int      @default(6)
  features        String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SystemConfiguration — Global admin kill-switches
// ─────────────────────────────────────────────
model SystemConfiguration {
  id                     Int      @id @default(autoincrement())
  whatsappEnabled        Boolean  @default(true)
  emailEnabled           Boolean  @default(true)
  invoiceCreationEnabled Boolean  @default(true)
  paymentsEnabled        Boolean  @default(true)
  globalNotice           String?
  maintenanceMode        Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

// ─────────────────────────────────────────────
// AppNotification — In-app user notifications
// ─────────────────────────────────────────────
model AppNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // 'EMAIL_SENT', 'WHATSAPP_SENT', 'CLIENT_PAID', 'PARTIALLY_PAID', 'OVERDUE'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// Support Ticket System
// ─────────────────────────────────────────────
model Ticket {
  id        Int      @id @default(autoincrement())
  resendId  String?  @unique // Id from Resend Inbound (for replies/threading)
  subject   String
  fromEmail String
  fromName  String?
  status    String   @default("OPEN") // OPEN, PENDING, CLOSED
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conversation history
  messages TicketMessage[]

  // Link to user if email matches
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String // "ADMIN" or "USER"
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}
