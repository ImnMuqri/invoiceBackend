# ═══════════════════════════════════════════════════════════════════════════
# InvoKita backend — environment
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy to .env for local development. The real values live in Railway.
# This file is COMMITTED and must never contain a real secret — it exists so
# that "which variables does this service need" has an answer that is not
# "read server.js and grep".
#
# Variables marked REQUIRED are checked at boot by validateEnv() in server.js;
# the service refuses to start without them rather than failing later in a way
# that looks like a different bug.

# ─── Core ──────────────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED. Signs session tokens, and is also the salt for the PDF render
# tokens and the referral click hashes — rotating it invalidates all three.
JWT_SECRET=generate_a_long_random_string

# REQUIRED. Encrypts stored payment-gateway credentials at rest.
ENCRYPTION_KEY=generate_a_32_byte_key

# Where each half of the app lives. FRONTEND_URL is used to build every link
# that leaves the system — payment pages, quotation links, referral links — so
# a wrong value here produces messages whose links go nowhere.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3002

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_SUPPORT_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ─── WhatsApp (Twilio) ─────────────────────────────────────────────────────
# The system sender. Users on CUSTOM mode supply their own, stored per account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── AI drafting (Groq) ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# ─── Subscriptions (Xendit) ────────────────────────────────────────────────
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxx

# MUST BE SET IN PRODUCTION. Without it the webhook handler refuses every
# callback — deliberately, because an unverified webhook that names a plan in
# its reference_id is a free self-upgrade. Failing closed means genuine
# payments stop upgrading anyone until this is set, which is the right side to
# fail on but does mean it cannot be forgotten.
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token

# ─── Payment gateway sandboxes ─────────────────────────────────────────────
# "true" points the connector at the provider's test environment. Anything
# else, including unset, means live.
TOYYIBPAY_SANDBOX=true
BILLPLZ_SANDBOX=true
HITPAY_SANDBOX=true
SENANGPAY_SANDBOX=true

# ─── Cloudflare R2 — logo storage ──────────────────────────────────────────
# Without these the logo upload falls back to the container filesystem, which
# is EPHEMERAL on Railway: every deploy wipes the files while the stored
# logoUrl still points at them, so invoices quietly go out unbranded.
#
# The bucket is PUBLIC rather than signed-URL, because all three surfaces that
# render a logo run without a session: the PDF (headless Chrome loading
# /invoices/:id/export), the public payment page and the public quotation page.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=invokita
# No trailing slash. This string is stored inside logoUrl, so changing it later
# orphans every existing logo — prefer a custom domain you control over the
# r2.dev subdomain.
R2_PUBLIC_URL=https://pub-replace-me.r2.dev

# ─── Marketing site ────────────────────────────────────────────────────────
# Where attribution and referral links point. Defaults to https://invokita.my.
MARKETING_URL=https://invokita.my
